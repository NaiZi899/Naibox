{
  "listen": ":7863",
  "api_key": "your-api-key-here",
  "service_name": "omni2api",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "server": {
    "max_body_mb": 8
  },
  "login": {
    "open_browser": true,
    "browser": "",
    "isolated": true,
    "profile_mode": "temp"
  },
  "cooldown": {
    "soft_rate": "60s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "keepalive_hours": [22],
    "checkin_enabled": true,
    "keepalive_enabled": true,
    "activity_hours": [10],
    "activity_enabled": true
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "client_name": "",
    "device_token": "",
    "device_token_file": "",
    "passthrough_ip": false
  },
  "codearts": {
    "enabled": true,
    "refresh_interval_seconds": 60
  },
  "cline": {
    "enabled": true,
    "auth_dir": "./auths/cline",
    "pool_accounts": true
  },
  "raccoon": {
    "enabled": true,
    "auth_dir": "./auths/raccoon",
    "pool_accounts": true
  },
  "lobsterai": {
    "enabled": true,
    "auth_dir": "./auths/lobsterai",
    "pool_accounts": true
  },
  "qoder": {
    "enabled": true,
    "cn_enabled": true,
    "auth_dir": "./auths/qoder",
    "pool_accounts": true
  },
  "workbuddy_intl": {
    "enabled": true,
    "oauth_base_url": "https://www.workbuddy.ai",
    "auth_dir": "",
    "pool_accounts": true
  },
  "trae": {
    "enabled": true,
    "auth_dir": "./auths/trae",
    "refresh_interval_seconds": 1800,
    "checkin_enabled": true,
    "pool_accounts": true,
    "oauth_callback_port": "18080",
    "fallback_enabled": true,
    "queue_threshold": 300,
    "max_attempts": 3,
    "client_id": ""
  },
  "loomy": {
    "enabled": true,
    "auth_dir": "./auths/loomy",
    "base_url": "https://loomyad.xunfei.cn/api/v1",
    "pool_accounts": true,
    "client_data_dir": ""
  },
  "inkstone": {
    "enabled": true,
    "auth_dir": "./auths/inkstone",
    "pool_accounts": true
  },
  "jiyuan": {
    "enabled": true,
    "auth_dir": "./auths/jiyuan",
    "pool_accounts": true,
    "mgmt_base": ""
  },
  "custom_upstreams": [
    {
      "id": "my-openai",
      "name": "我的 OpenAI 反代",
      "enabled": false,
      "base_url": "https://api.example.com/v1",
      "api_key": "sk-replace-me",
      "models": ["gpt-4o-mini"],
      "timeout_seconds": 120,
      "shards": 1
    },
    {
      "id": "my-multi-key",
      "name": "多密钥示例",
      "enabled": false,
      "base_url": "https://api.example.com/v1",
      "api_keys": ["sk-key-one", "sk-key-two"],
      "models": ["gpt-4o-mini"],
      "shards": 1
    }
  ],
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "prompt": {
    "_comment_mode": "mode is one of three values: passthrough (default) = replace the client system/developer messages with the gateway prompt, which removes that fingerprint source entirely | append = keep the client system/developer messages and add one gateway system message after them; the client's template lines stay in the request, so fingerprints are only mitigated by the appended text plus the sanitize layer and a residual 400 is possible (falls back to the degraded prompt and retries) | passthrough = forward the client system untouched. Empty mode = passthrough.",
    "_comment_file": "file: empty = use the built-in default persona (about 2KB; combining it with mode=append costs double tokens and stacks two personas). A missing, unreadable or empty file aborts startup, and so does a prompt whose text matches the sanitize fingerprint table - it would be rewritten before sending, so what you configure would not be what the upstream receives. The NAIBOX_PROMPT_MODE environment variable overrides mode at startup (rollback switch, e.g. NAIBOX_PROMPT_MODE=passthrough).",
    "mode": "passthrough",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "max_in_flight": 3,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0,
    "health_check_interval_seconds": 600,
    "quota_refresh_interval_seconds": 900,
    "restricted_rotate_max": 0
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  },
  "backup": {
    "_comment_enabled": "按 hours 定时备份。缺省 false：升级上来的部署不该在夜里突然往网络上传东西。",
    "enabled": false,
    "_comment_hours": "每天哪几个整点跑（0-23）。空 = 只手动备份。",
    "hours": [],
    "keep": 10,
    "channels": [
      {
        "_comment": "local 通道永远可用：远端挂了，本地还留着一份能立刻恢复的包。",
        "id": "local",
        "kind": "local",
        "dir": "",
        "enabled": true
      },
      {
        "_comment": "s3：bucket/region/prefix 按你的对象存储填；endpoint 必须是 https。启用前把 enabled 改成 true。",
        "id": "s3",
        "kind": "s3",
        "enabled": false,
        "endpoint": "",
        "bucket": "",
        "region": "",
        "prefix": "naibox/",
        "access_key": "",
        "secret_key": ""
      },
      {
        "_comment": "openlist：本机 AList/OpenList 默认 http://127.0.0.1:5244，token 在「其他设置 → 令牌」。",
        "id": "openlist",
        "kind": "openlist",
        "enabled": false,
        "endpoint": "http://127.0.0.1:5244",
        "token": "",
        "remote_dir": "/naibox-backups"
      }
    ]
  },
  "egress": []
}
